APP_NAME=Personal Agent API
ENVIRONMENT=development
LOG_LEVEL=INFO
LLM_TIMEOUT_SECONDS=30
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
LLM_MAX_OUTPUT_TOKENS=1024
STREAM_RESPONSES=false

# Langfuse tracing turns on when both keys are set; leave them empty to disable it.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CAPTURE_CONTENT=false

# Required: Neon direct connection string (connection pooling off), see README.
DATABASE_URL=postgresql://<role>:<password>@ep-xxxx.<region>.aws.neon.tech/<db>?sslmode=require
DB_POOL_SIZE=5

# Set LLM_PROVIDER=mock for offline development without a Gemini key.
